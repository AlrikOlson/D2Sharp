<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    This targets file is automatically imported by NuGet into consuming projects.
    It copies D2Sharp.Worker files from the package to the consuming project's output directory.

    For local development with project references, this file is also imported by D2Sharp.csproj.
  -->

  <!-- Copy D2Sharp.Worker files to consuming project's output directory -->
  <Target Name="CopyD2SharpWorkerFiles" AfterTargets="Build">
    <PropertyGroup>
      <!-- For NuGet package: Worker files are in build/D2Sharp.Worker/ -->
      <_D2SharpWorkerNuGetPath>$(MSBuildThisFileDirectory)D2Sharp.Worker/</_D2SharpWorkerNuGetPath>

      <!-- For project references: Worker is in ../D2Sharp.Worker/bin/... -->
      <_D2SharpWorkerProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../D2Sharp.Worker/bin/$(Configuration)/net8.0/'))</_D2SharpWorkerProjectPath>

      <!-- Choose the path that exists (NuGet package path takes precedence) -->
      <_D2SharpWorkerSourcePath Condition="Exists('$(_D2SharpWorkerNuGetPath)D2Sharp.Worker.dll')">$(_D2SharpWorkerNuGetPath)</_D2SharpWorkerSourcePath>
      <_D2SharpWorkerSourcePath Condition="'$(_D2SharpWorkerSourcePath)' == '' AND Exists('$(_D2SharpWorkerProjectPath)D2Sharp.Worker.dll')">$(_D2SharpWorkerProjectPath)</_D2SharpWorkerSourcePath>
    </PropertyGroup>

    <!-- Copy all Worker files if source path was located -->
    <ItemGroup Condition="'$(_D2SharpWorkerSourcePath)' != ''">
      <_D2SharpWorkerFilesToCopy Include="$(_D2SharpWorkerSourcePath)D2Sharp.Worker*" />
      <_D2SharpWorkerFilesToCopy Include="$(_D2SharpWorkerSourcePath)Microsoft.Extensions.*.dll" />
    </ItemGroup>

    <Copy Condition="'$(_D2SharpWorkerSourcePath)' != ''"
          SourceFiles="@(_D2SharpWorkerFilesToCopy)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />

    <!-- Warn if Worker files were not found -->
    <Warning Condition="'$(_D2SharpWorkerSourcePath)' == ''" Text="D2Sharp.Worker executable not found. Process isolation will not be available. Run 'dotnet build' at solution level or ensure Worker project is built." />
  </Target>
</Project>
