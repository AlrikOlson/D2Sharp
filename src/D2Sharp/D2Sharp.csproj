<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <WasmNativeLib>d2wrapper</WasmNativeLib>
        <LangVersion>latest</LangVersion>

        <!-- Version information -->
        <VersionPrefix>0.3.1</VersionPrefix>
        <VersionSuffix></VersionSuffix>
        <AssemblyVersion>0.3.1.0</AssemblyVersion>
        <FileVersion>0.3.1.0</FileVersion>
        <InformationalVersion>$(VersionPrefix)</InformationalVersion>

        <!-- Package metadata -->
        <PackageId>D2Sharp</PackageId>
        <Product>D2Sharp</Product>
        <Authors>AlrikOlson</Authors>
        <Description>A production-ready .NET wrapper for D2, the modern diagram scripting language. Render D2 diagrams as SVG with full support for themes, layout engines (Dagre/ELK), sketch mode, and async/await patterns. Thread-safe, cross-platform, and ready for production use.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/AlrikOlson/D2Sharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AlrikOlson/D2Sharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>d2;diagrams;visualization;svg;d2lang;graph;chart;dagre;elk;rendering</PackageTags>
        <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>

        <!-- Documentation and symbols -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>bin\Release\</OutputPath>
    </PropertyGroup>

    <Target Name="BuildD2Wrapper" BeforeTargets="PreBuildEvent" Condition="'$(CI)' != 'true'">
        <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)d2wrapper\build.ps1&quot; $(Configuration)"/>
        <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -File &quot;$(ProjectDir)d2wrapper\build.ps1&quot; $(Configuration)"/>
    </Target>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="runtimes\**\*">
            <Pack>true</Pack>
            <PackagePath>runtimes</PackagePath>
        </Content>
    </ItemGroup>

    <PropertyGroup>
        <NativeLibExtension Condition="$([MSBuild]::IsOSPlatform('Windows'))">.dll</NativeLibExtension>
        <NativeLibExtension Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</NativeLibExtension>
        <NativeLibExtension Condition="$([MSBuild]::IsOSPlatform('Linux'))">.so</NativeLibExtension>
        <NativeLibExtension Condition="'$(NativeLibExtension)' == ''">.dll</NativeLibExtension>
        <NativeLibName>d2wrapper$(NativeLibExtension)</NativeLibName>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(NativeLibName)" Link="$(NativeLibName)" Condition="'$(CI)' != 'true'">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.9"/>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.9"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
</Project>
