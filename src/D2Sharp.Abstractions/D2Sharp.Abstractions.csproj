<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Version information -->
        <VersionPrefix>0.3.2</VersionPrefix>
        <VersionSuffix></VersionSuffix>
        <AssemblyVersion>0.3.2.0</AssemblyVersion>
        <FileVersion>0.3.2.0</FileVersion>
        <InformationalVersion>$(VersionPrefix)</InformationalVersion>

        <!-- Package metadata -->
        <PackageId>D2Sharp.Abstractions</PackageId>
        <Product>D2Sharp.Abstractions</Product>
        <Authors>AlrikOlson</Authors>
        <Description>Abstractions for D2Sharp, the production-ready .NET wrapper for D2 diagram scripting language. Contains interfaces, options, and contracts for implementing custom D2 renderers.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/AlrikOlson/D2Sharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AlrikOlson/D2Sharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>d2;diagrams;visualization;svg;d2lang;abstractions;interfaces</PackageTags>

        <!-- Documentation and symbols -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
</Project>
