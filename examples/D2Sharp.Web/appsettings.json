{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "RenderEndpoint": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "Validation": {
    "MaxScriptLength": 100000
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  }
}
